SHELL = kash

default : test

setup :
	uv sync --extra mcp --extra interactive

test :
	uv run --extra mcp --extra interactive python -m unittest discover -s tests -p "test_*.py"

# End-to-end scenarios against a real engine: they cost tokens (tests/gold/README.md)
gold :
	tests/gold/run.sh

# What goals cost from start to result, by stage; appends to $GOLD_ROOT/bench.jsonl
bench :
	tests/gold/bench.sh

check : test
	uv run python -m compileall -q src/py
